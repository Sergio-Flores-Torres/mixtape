{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "providers": {
    "gemini": {
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": "GEMINI_API_KEY",
      "requestsPerMinute": 5,
      "maxConcurrent": 1,
      "maxRetries": 4
    },
    "nvidia": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "requestsPerMinute": 20,
      "maxConcurrent": 1,
      "maxRetries": 4
    }
  },
  "models": {
    "z-ai/glm-5.2": {
      "provider": "nvidia"
    },
    "nvidia/nemotron-3-ultra-550b-a55b": {
      "provider": "nvidia",
      "body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        },
        "reasoning_budget": 16384
      }
    },
    "nvidia/nemotron-3-nano-30b-a3b": {
      "provider": "nvidia"
    },
    "gemini-2.5-flash": {
      "provider": "gemini"
    },
    "gemma4-31b": {
      "provider": "gemini"
    },
    "gemma4-26b": {
      "provider": "gemini"
    },
    "gemini-3.6-flash": {
      "provider": "gemini"
    },
    "gemini-3.5-flash": {
      "provider": "gemini"
    },
    "gemini-3.0-flash": {
      "provider": "gemini"
    }
  }
}
